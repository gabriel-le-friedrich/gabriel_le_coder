<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- ── Permissions ────────────────────────────────────────────────────────── -->

    <!-- Required for all Firebase (Auth, Firestore, Storage) network calls -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Camera: used by the HTML file input for pig weekly photo capture.
         The OS camera picker (ACTION_IMAGE_CAPTURE) fires automatically when
         the user taps an <input type="file" accept="image/*" capture> element —
         Capacitor's WebView passes that intent through to the system, which
         still needs this permission declared here on Android 9 and below.
         Android 10+ no longer requires it for ACTION_IMAGE_CAPTURE, but
         declaring it is harmless and keeps older-device support intact. -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- Read media images (Android 13+): required to access gallery photos
         when a user picks a pig photo from their library rather than capturing
         a new one. On Android ≤12 the legacy READ_EXTERNAL_STORAGE covers this. -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <!-- Legacy storage read for Android ≤12 -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <!-- Local (on-device) notifications for feeding/health/weigh-in reminders,
         requested contextually when the user reaches "Set Reminders" during
         onboarding — not at app startup. Required as a runtime permission on
         Android 13+ (API 33); declaring it here is required even though
         @capacitor/local-notifications' own manifest also declares it, since
         Gradle's manifest merger only guarantees the *declaration* merges,
         not that the app requests it at the right moment (that's handled in
         JS via LocalNotifications.requestPermissions()). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

</manifest>
